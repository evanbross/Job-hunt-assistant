{
  "manifest_version": 3,
  "name": "Job Hunt Assistant",
  "description": "Capture job listings from any page and send them to Job Hunt Assistant",
  "version": "1.22.1",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage", "notifications", "alarms", "tabs"],
  "host_permissions": ["http://localhost/*", "http://*.localhost/*", "https://*/*", "ws://localhost/*", "ws://*.localhost/*", "wss://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Job Hunt Assistant"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "job-hunt-assistant@eross.com",
      "strict_min_version": "109.0"
    }
  }
}
