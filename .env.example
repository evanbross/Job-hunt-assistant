#
# Job Hunt Assistant environment defaults
#

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Bootstrap-only. ANTHROPIC_API_KEY/OPENAI_API_KEY, if set, are copied once
# into the first account's encrypted per-user settings on first startup (see
# backend/db/schema.py's _seed_settings_from_env) and never read again after
# that -- each account manages its own key from then on via Settings >
# Configuration, since API billing is per-account, not per-instance.
# ai_provider/anthropic_model/openai_model/ollama_base_url/ollama_model are
# also per-account settings now (Settings > Configuration), not read from
# .env at all -- data/runtime_config.json is a one-time legacy migration
# source only, not a live config layer. SMTP credentials, by contrast, are
# instance-wide (one relay for every account on this install) and are edited
# via Settings > System (admin only) instead of .env at all.
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# ─── Required secrets ─────────────────────────────────────────────────────────
# The app REFUSES TO START without strong values for these two. Generate both with:
#   python scripts/manage_secrets.py generate
# Neither can live in the database they protect. Back them up with your DB
# credentials: losing SETTINGS_ENCRYPTION_KEY makes every stored secret
# unrecoverable. To replace a value already in use, see docs/secrets-and-key-rotation.md.
#
# Signs session cookies (32+ random characters).
FLASK_SECRET_KEY=
# Encrypts stored API keys, Google/Greenhouse tokens, and resume PDFs (a Fernet key).
SETTINGS_ENCRYPTION_KEY=
# Old values kept readable during a rotation (comma-separated); normally unset.
# FLASK_SECRET_KEY_FALLBACKS=
# SETTINGS_ENCRYPTION_KEY_FALLBACKS=
# "production" (default) fails on a missing/weak secret. "development" (local use
# only) generates a missing FLASK_SECRET_KEY into this file for you.
# APP_ENV=development
# Session cookie Secure flag: auto (Secure when APP_BASE_URL is https), true, or false.
# SESSION_COOKIE_SECURE=auto

# ─── Cover letter prompt / legacy candidate profile ──────────────────────────
# Optional override for where the editable cover letter prompt template lives
# (defaults to the project root; auto-created on first run if missing).
# COVER_LETTER_PROMPT_PATH=cover_letter_prompt.md
# Optional override for where the editable fit-scorer prompt template lives
# (defaults to the project root; auto-created on first run if missing). Point
# this at a private repo if the prompt contains personal scoring preferences
# you don't want in the (public) project repo.
# FIT_SCORER_PROMPT_PATH=fit_scorer_prompt.md
# The candidate profile is no longer a file: it is saved per account in the
# app (Settings > Career Profile > Profile Settings). This variable only tells
# the one-time startup migration where an old install's profile file is, so it
# can be copied into the owning account.
# CANDIDATE_PROFILE_PATH=candidate_profile.md
# To keep editing the profile as a file, set Settings > System > Candidate
# Profile File Sync instead: when the saved file is newer than the account's
# stored profile, the app shows that account a banner to review and load it.

# ─── App Defaults ─────────────────────────────────────────────────────────────
EMAIL_LOOKBACK_DAYS=10
# Optional -- leave unset to default to ".Job Hunt/<current year>/Scanned By Assistant"
# (see config.py's DEFAULT_SCANNED_EMAIL_LABEL). Also editable anytime via Settings -> Email.
# SCANNED_EMAIL_LABEL=.Job Hunt/2026/Scanned By Assistant
MOVE_SUCCESSFULLY_PROCESSED_EMAILS=false
# Read by routes/career_sites.py for status display only. The scheduler that would
# actually use this for automatic scanning (backend/scanning/schedulers.py's
# start_career_site_scheduler) is intentionally never started -- career-site scans
# are triggered manually from the UI banner instead (see app.py). Changing this
# value has no effect on scan timing today.
CAREER_SITE_SCAN_INTERVAL_MINUTES=30

# ─── Server bind ──────────────────────────────────────────────────────────────
# Bootstrap-only, same pattern as the AI provider keys above: copied once into
# system_settings on first startup, then edited via Settings > System (admin
# only) from then on -- not read from .env again. A change always needs an
# app restart, since the listening socket is already bound by the time any
# setting could be re-read.
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5004

# ─── Job Import Listener ──────────────────────────────────────────────────────
# Local listener for the browser extension. Every request must carry a per-user token
# created in the app under Settings > Browser Extension (there is no shared token setting).
# Changes require an app restart because the listener port is bound at startup.
JOB_IMPORT_LISTENER_ENABLED=true
JOB_IMPORT_LISTENER_HOST=127.0.0.1
JOB_IMPORT_LISTENER_PORT=8765
JOB_IMPORT_LISTENER_MAX_BYTES=15728640

# ─── Database ─────────────────────────────────────────────────────────────────
# Postgres only. Two roles (see config.py and backend/db/app_role.py):
#   owner   -- owns the tables; runs migrations and cross-account maintenance.
#              Exempt from row-level security, so the app never serves with it.
#   runtime -- what the app serves requests with. Pick any new user name and a long
#              random password; migrations create the role from these values.
# Either give whole URLs:
#   DATABASE_OWNER_URL=postgresql://owner-user:owner-password@localhost:5432/jobhunt
#   DATABASE_URL=postgresql://jha_app:runtime-password@localhost:5432/jobhunt
# or the parts below.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jobhunt
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_APP_USER=jha_app
POSTGRES_APP_PASSWORD=generate-a-long-random-value
POSTGRES_SSLMODE=disable

# ─── Test Database ────────────────────────────────────────────────────────────
# Used by tests/conftest.py's pg_dsn fixture, entirely separate from the app's
# own database (which may be a remote Neon instance). Run scripts/setup_test_db.sql
# once against your local Postgres to create it. Local installs typically have
# no SSL configured, so the fixture always connects with sslmode=disable.
#
# LOCAL_POSTGRES_USER must be jha_test_app (created by setup_test_db.sql), not your
# Postgres superuser -- superusers bypass row-level security unconditionally
# (backend/db/row_level_security.py), so testing through one would prove nothing.
# jha_test_app is the test database's owner; the app under test serves as a separate
# runtime role (jha_test_runtime, see tests/db_roles.py) that migrations create.
LOCAL_POSTGRES_HOST=localhost
LOCAL_POSTGRES_PORT=5432
LOCAL_POSTGRES_DB=jha_test_db
LOCAL_POSTGRES_USER=jha_test_app
LOCAL_POSTGRES_PASSWORD=jha_test_app_password
