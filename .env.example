#
# Job Hunt Assistant environment defaults
#

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Bootstrap-only. ANTHROPIC_API_KEY/OPENAI_API_KEY, if set, are copied once
# into the first account's encrypted per-user settings on first startup (see
# backend/db/schema.py's _seed_settings_from_env) and never read again after
# that -- each account manages its own key from then on via Settings >
# Configuration, since API billing is per-account, not per-instance. SMTP
# credentials, by contrast, are instance-wide (one relay for every account on
# this install) and are edited via Settings > System (admin only) instead of
# .env at all. ai_provider, openai_model, ollama_base_url, and ollama_model
# remain instance-wide preferences in data/runtime_config.json for now.
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# ─── Settings encryption ──────────────────────────────────────────────────────
# Encrypts secrets stored in system_settings/user_settings (SMTP password, AI
# provider keys, scraper creds). Same bootstrap-only tier as FLASK_SECRET_KEY
# below -- it can't live in the DB it protects. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up alongside your DB credentials -- losing it makes every stored
# secret unrecoverable.
SETTINGS_ENCRYPTION_KEY=generate-with-the-command-above

# ─── Candidate profile / cover letter prompt ─────────────────────────────────
# Optional overrides for where these editable text files live. Both default to
# the project root and are auto-created on first run if missing.
# CANDIDATE_PROFILE_PATH=candidate_profile.md
# COVER_LETTER_PROMPT_PATH=cover_letter_prompt.md

# ─── App Defaults ─────────────────────────────────────────────────────────────
EMAIL_LOOKBACK_DAYS=10
SCANNED_EMAIL_LABEL=.Job Hunt 2025/Scanned By Assistant
MOVE_SUCCESSFULLY_PROCESSED_EMAILS=false
CAREER_SITE_SCAN_INTERVAL_MINUTES=30
FLASK_SECRET_KEY=change-this-in-production
GOOGLE_SHEETS_ID=your-google-sheets-id

# ─── Server bind ──────────────────────────────────────────────────────────────
# Bootstrap-only, same pattern as the AI provider keys above: copied once into
# system_settings on first startup, then edited via Settings > System (admin
# only) from then on -- not read from .env again. A change always needs an
# app restart, since the listening socket is already bound by the time any
# setting could be re-read.
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5004

# ─── Job Import Listener ──────────────────────────────────────────────────────
# Local listener for browser extensions/bookmarklets that send captured job-board HTML.
# Changes require an app restart because the listener port is bound at startup.
JOB_IMPORT_LISTENER_ENABLED=true
JOB_IMPORT_LISTENER_HOST=127.0.0.1
JOB_IMPORT_LISTENER_PORT=8765
JOB_IMPORT_LISTENER_TOKEN=
JOB_IMPORT_LISTENER_MAX_BYTES=15728640

# ─── Jobanni scanner ──────────────────────────────────────────────────────────
# Full search URL — edit q=, location=, and type= to change what's scraped.
JOBANNI_SEARCH_URL=https://jobanni.com/search?q=software+engineer&location=United+States&type=remote
JOBANNI_MAX_JOBS=50

# ─── Database ─────────────────────────────────────────────────────────────────
# Postgres only — either set DATABASE_URL directly, or the POSTGRES_* parts below.
DATABASE_URL=postgresql://your-postgres-user:your-postgres-password@localhost:5432/jobhunt
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jobhunt
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_SSLMODE=disable

# ─── Test Database ────────────────────────────────────────────────────────────
# Used by tests/conftest.py's pg_dsn fixture, entirely separate from the app's
# own database (which may be a remote Neon instance). Run scripts/setup_test_db.sql
# once against your local Postgres to create it. Local installs typically have
# no SSL configured, so the fixture always connects with sslmode=disable.
LOCAL_POSTGRES_HOST=localhost
LOCAL_POSTGRES_PORT=5432
LOCAL_POSTGRES_DB=jha_test_db
LOCAL_POSTGRES_USER=postgres
LOCAL_POSTGRES_PASSWORD=your-local-postgres-password
