#
# Job Hunt Assistant environment defaults
#

# ─── AI Providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
AI_PROVIDER=anthropic
OPENAI_MODEL=gpt-4.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:32b

# ─── Candidate profile / cover letter prompt ─────────────────────────────────
# Optional overrides for where these editable text files live. Both default to
# the project root and are auto-created on first run if missing.
# CANDIDATE_PROFILE_PATH=candidate_profile.md
# COVER_LETTER_PROMPT_PATH=cover_letter_prompt.md

# ─── App Defaults ─────────────────────────────────────────────────────────────
EMAIL_LOOKBACK_DAYS=10
SCANNED_EMAIL_LABEL=.Job Hunt 2025/Scanned By Assistant
MOVE_SUCCESSFULLY_PROCESSED_EMAILS=false
CAREER_SITE_SCAN_INTERVAL_MINUTES=30
FLASK_SECRET_KEY=change-this-in-production
GOOGLE_SHEETS_ID=your-google-sheets-id

# ─── Job Import Listener ──────────────────────────────────────────────────────
# Local listener for browser extensions/bookmarklets that send captured job-board HTML.
# Changes require an app restart because the listener port is bound at startup.
JOB_IMPORT_LISTENER_ENABLED=true
JOB_IMPORT_LISTENER_HOST=127.0.0.1
JOB_IMPORT_LISTENER_PORT=8765
JOB_IMPORT_LISTENER_TOKEN=
JOB_IMPORT_LISTENER_MAX_BYTES=15728640

# ─── Jobanni scanner ──────────────────────────────────────────────────────────
# Full search URL — edit q=, location=, and type= to change what's scraped.
JOBANNI_SEARCH_URL=https://jobanni.com/search?q=software+engineer&location=United+States&type=remote
JOBANNI_MAX_JOBS=50

# ─── Database ─────────────────────────────────────────────────────────────────
# Set DATABASE_BACKEND to postgres or sqlite.
DATABASE_BACKEND=sqlite
SQLITE_DATABASE_PATH=data/job_hunt_assistant.sqlite3
DATABASE_URL=postgresql://your-postgres-user:your-postgres-password@localhost:5432/jobhunt
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jobhunt
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_SSLMODE=disable
