# Settings only the migrate step sees. Copy to deploy/.env.migrate (git-ignored).
#
# The schema owner: the role that owns every table. Migrations need it because the
# owner is exempt from row-level security (backfills and seed data cross accounts).
# The app containers never get this URL; they serve as DATABASE_URL's runtime role.
DATABASE_OWNER_URL=postgresql://owner:password@db.example.com:5432/jobhunt?sslmode=require
