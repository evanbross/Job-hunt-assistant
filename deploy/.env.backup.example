# Off-site database backups (backend/db/backup.py). Copy to deploy/.env.backup
# (git-ignored). Only the `maintenance` service reads it; it refuses to start without it.
# See deploy/README.md "Backups and restore".

# ── Where backups go: any S3-compatible bucket ───────────────────────────────
# Use a different provider (or at least a different account) from the database, so one
# lost account can't take both. Give these credentials the narrowest access the provider
# offers -- ideally write-only, no delete (AWS: s3:PutObject + s3:AbortMultipartUpload;
# B2: writeFiles) -- set retention as the bucket's own lifecycle rule (e.g. expire after
# 35 days), and turn on object lock (R2 bucket locks, S3/B2 object lock) so even a
# leaked key with delete rights can't destroy backups younger than the lock.
BACKUP_S3_BUCKET=jha-backups
# Cloudflare R2: https://<account id>.r2.cloudflarestorage.com, region auto.
# Backblaze B2: https://s3.<region>.backblazeb2.com. AWS S3: leave the endpoint unset.
BACKUP_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_PREFIX=jha-backups/
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# ── Encryption: age public keys (age-keygen prints one; space- or comma-separated) ──
# The server only ever holds these PUBLIC keys, so it can write backups but never read
# one. Keep each private key (the age identity file) offline, NOT on this server and
# not in the bucket. Two recipients (e.g. yours and a sealed recovery copy) means
# losing one key doesn't lose the backups.
BACKUP_AGE_RECIPIENTS=

# ── Schedule ─────────────────────────────────────────────────────────────────
# Hours between backups. Beat checks hourly, so a failed backup retries within the hour.
BACKUP_INTERVAL_HOURS=24
