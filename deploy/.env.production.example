# Production settings. Copy to deploy/.env.production (git-ignored) and fill in.
# In a real deployment, source these from your secrets manager and inject them as
# environment variables; do not keep long-lived secrets in a file on the host.

# ── Edge ─────────────────────────────────────────────────────────────────────
APP_DOMAIN=jobs.example.com
ACME_EMAIL=you@example.com
APP_BASE_URL=https://jobs.example.com

# ── Image ────────────────────────────────────────────────────────────────────
# The tag the repository's Dockerfile was built and pushed as:
#   docker build -t registry.example.com/job-hunt-assistant:1.0.0 .
JHA_IMAGE=registry.example.com/job-hunt-assistant:1.0.0

# ── Secrets (generate: python scripts/manage_secrets.py generate) ────────────
FLASK_SECRET_KEY=
SETTINGS_ENCRYPTION_KEY=
# Any long random value: python -c "import secrets; print(secrets.token_urlsafe(32))"
# (URL-safe characters only; it is embedded in the Redis URL.)
REDIS_PASSWORD=
# The voice-query feature's SELECT-only database role. migrate sets the role's password
# to this and the app connects with it. Any long random value, generated the same way.
READONLY_DB_PASSWORD=

# ── Database (managed Postgres, TLS required) ────────────────────────────────
# The runtime role the app serves with: not the owner of the tables, so row-level
# security applies to it. Choose a user name and a long random password; the migrate
# step creates the role from them. The owner's URL is NOT here: it goes in
# deploy/.env.migrate (see .env.migrate.example), which only the migrate step reads.
DATABASE_URL=postgresql://jha_app:password@db.example.com:5432/jobhunt?sslmode=require

# ── Web server capacity (gunicorn.conf.py) ───────────────────────────────────
# Concurrent connections = workers x threads, and every open browser tab holds one
# (its /api/events stream). Size for peak open tabs across all users, plus headroom.
GUNICORN_WORKERS=2
GUNICORN_THREADS=32

# ── Background workers ───────────────────────────────────────────────────────
# Threads in the `worker` service (every background task but the maintenance sweep).
CELERY_CONCURRENCY=4

# ── Session cookie ───────────────────────────────────────────────────────────
# auto = Secure whenever APP_BASE_URL is https (it is, above).
SESSION_COOKIE_SECURE=auto
